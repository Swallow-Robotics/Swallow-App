# ---- Supabase (required) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Cloudflare R2 (required) ----
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-r2-public-url.r2.dev

# ---- Public app origin (optional) ----
# Used to build durable public links (e.g. the public photo viewer URL
# embedded in Photos PDF exports). Falls back to the first FRONTEND_ORIGIN
# entry, then to the request's own origin, if unset.
PUBLIC_APP_ORIGIN=https://your-frontend-domain.com
