# ---- Supabase (required) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Cloudflare R2 (required) ----
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-r2-public-url.r2.dev

# ---- Frontend CORS origin (required in production) ----
# Comma-separated list of allowed browser origins. Must include the scheme.
# Example production value:
# FRONTEND_ORIGIN=https://swallow-ctr.com,https://www.swallow-ctr.com
FRONTEND_ORIGIN=http://localhost:3000

# ---- Public app origin (optional) ----
# Used to build durable public links (e.g. the public photo viewer URL
# embedded in Photos PDF exports). Falls back to the first FRONTEND_ORIGIN
# entry, then to the request's own origin, if unset.
PUBLIC_APP_ORIGIN=https://swallow-ctr.com

# ---- Contact / demo form (optional) ----
# When SMTP_HOST is set, POST /api/v1/contact emails submissions.
# Without SMTP, submissions are accepted and logged (useful for local/test).
# CONTACT_EMAIL_TO=contact@swallow-ctr.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
