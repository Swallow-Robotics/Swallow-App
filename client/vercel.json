{
  "buildCommand": "yarn install && yarn build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    {
      "source": "/public/photos-link/:token",
      "destination": "/api/public-link-html?token=:token"
    },
    {
      "source": "/public/photos-link/:token/",
      "destination": "/api/public-link-html?token=:token"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
